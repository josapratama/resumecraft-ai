# ==============================================================================
# ResumeCraft AI - Production Environment Variables
# ==============================================================================

# ─── App Configuration ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_PORT=3000

# ─── Database Configuration ───────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: For Docker deployment, use 'mysql' as the host. For local development, use 'localhost'.
DB_USER=cv_user
DB_PASSWORD=cv_secure_password_here
DB_NAME=cv_builder
DB_ROOT_PASSWORD=root_secure_password_here
DB_PORT=3306

DATABASE_URL=mysql://cv_user:cv_secure_password_here@mysql:3306/cv_builder

# ─── Authentication & Security ────────────────────────────────────────────────
# Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_chars_or_more

# ─── AI Service (OpenAI-compatible) ───────────────────────────────────────────
# Compatible with OpenAI, DeepSeek, Groq, OpenRouter, Ollama, etc.
# Examples:
# Standard OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com
#   AI_MODEL=gpt-4o-mini
#
# DeepSeek:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com
#   AI_MODEL=deepseek-chat
#
# Groq:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai
#   AI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini

# Or Forge API (if using Manus/Forge platform):
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Optional Services ────────────────────────────────────────────────────────
# phpMyAdmin port (bound to 127.0.0.1 for security)
PMA_PORT=8080

# Analytics (optional, leave blank to disable)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
